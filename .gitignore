# ==================== Godot 4 ====================
# 编辑器配置、导入缓存、着色器缓存等，可完全再生
.godot/

# Godot 3 遗留的导入缓存目录（Godot 4 已废弃，防御性忽略）
.import/

# 由 CSV 等自动生成的翻译资源
*.translation

# 导出的游戏构建产物
/build/
/export/
export.cfg

# 导出预设：本工程不含密钥/证书，随工程提交；若将来加入签名信息再改回忽略
# export_presets.cfg

# 说明：*.import 与 *.uid 是 Godot 需要随工程走的元文件，必须提交，切勿忽略

# ==================== C# / .NET ====================
bin/
obj/
*.user
*.suo
*.userprefs
*.csproj.user
*.sln.docstates
*.DotSettings.user
.vs/
.idea/

# ==================== 系统 / 杂项 ====================
*.tmp
*.log
.DS_Store
Thumbs.db

# ==================== 非运行时内容（不入库） ====================
# 只提交游戏运行所需的文件：场景、C# 脚本、tres、glb、shader、工程配置。
# 以下类别属于开发期产物/证据，不入版本管理。

# 截图与视觉证据（含 Godot 生成的 .import 伴随文件）
.screenshots/
/screenshots/
doc/screenshots/
**/screenshots/

# Blender 工程文件与构建脚本（仅保留导出的 glb）
art/blender/
*.blend
*.blend1
*.blend2

# 生成/构建用的 Python 脚本
*.py

# 开发期辅助工具脚本
/tools/

# 编辑器 / 代理会话的本地配置与草稿
/.trae/

# 任务报告与中间产物（按日期归档的产出目录）
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
**/outputs/

# Local art production, intermediate assets, captures and validation tools.
/.Codex/
/.codex/
